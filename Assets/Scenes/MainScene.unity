  m_text: "\u0417\u0434\u0435\u0441\u044C \u043F\u043E\u044F\u0432\u0438\u0442\u0441\u044F
    \u043E\u0431\u044A\u044F\u0441\u043D\u0435\u043D\u0438\u0435 \u043D\u043E\u0432\u043E\u0439
    \u043C\u0435\u0445\u0430\u043D\u0438\u043A\u0438.\n\n\u0412\u043E \u0432\u0440\u0435\u043C\u044F
    \u0447\u0442\u0435\u043D\u0438\u044F \u0438\u0433\u0440\u0430 \u0441\u0442\u043E\u0438\u0442
    \u043D\u0430 \u043F\u0430\u0443\u0437\u0435. \u0417\u0430\u043A\u0440\u043E\u0439\u0442\u0435
    \u043E\u043A\u043D\u043E, \u043A\u043E\u0433\u0434\u0430 \u0431\u0443\u0434\u0435\u0442\u0435
    \u0433\u043E\u0442\u043E\u0432\u044B \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C.\n\n\u0414\u043B\u0438\u043D\u043D\u044B\u0439
    \u0442\u0435\u043A\u0441\u0442 \u043C\u043E\u0436\u043D\u043E \u043F\u0440\u043E\u043A\u0440\u0443\u0442\u0438\u0442\u044C
    \u043A\u043E\u043B\u0451\u0441\u0438\u043A\u043E\u043C \u043C\u044B\u0448\u0438."
