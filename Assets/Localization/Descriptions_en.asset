  m_SharedData: {fileID: 11400000, guid: 5818c1b60ea6b4645a467af69cab22c1, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 20545933312
    m_Localized: Socket Node can store a {gem|Gem} while allocated
    m_Metadata:
      m_Items: []
  - m_Id: 246914488602624
    m_Localized: Increases chance to land an attack
    m_Metadata:
      m_Items: []
  - m_Id: 247052791582720
    m_Localized: Its hit chance is checked against defender {evasion|Evasion}
    m_Metadata:
      m_Items: []
  - m_Id: 247115550953472
    m_Localized: Ailments are negative {effect|Effects} applied by hits
    m_Metadata:
      m_Items: []
  - m_Id: 247175881822208
    m_Localized: '{ignite|Ignite}, {chill|Chill}, {overcharge|Overcharge} and {bleed|Bleed}
      are ailments'
    m_Metadata:
      m_Items: []
  - m_Id: 247191832760320
    m_Localized: The base chance to inflict an Ailment is equal to the corresponding
      damage dealt by the hit as a percentage of the target's Max Health
    m_Metadata:
      m_Items: []
  - m_Id: 247264213864448
    m_Localized: Reduces incoming physical damage
    m_Metadata:
      m_Items: []
  - m_Id: 247311684997120
    m_Localized: Barrier charges absorb pgysical damage before health is hit
    m_Metadata:
      m_Items: []
  - m_Id: 247372057808896
    m_Localized: Any hit that is absorbed by a Barrier  breaks it
    m_Metadata:
      m_Items: []
  - m_Id: 247384347119616
    m_Localized: Each charge absorbs damage up to Barrier Capacity
    m_Metadata:
      m_Items: []
  - m_Id: 247399215927296
    m_Localized: Remaining damage beyond Barrier Capacity continues through
    m_Metadata:
      m_Items: []
  - m_Id: 247474637901824
    m_Localized: Bleed is an {ailment|Ailment} caused by Physical hits
    m_Metadata:
      m_Items: []
  - m_Id: 247487862542336
    m_Localized: It stores 30% of dealt Physical damage as damage over time
    m_Metadata:
      m_Items: []
  - m_Id: 247495907217408
    m_Localized: Each Bleed stack is a separate effect, and deals its stored damage
      evenly over 5 seconds
    m_Metadata:
      m_Items: []
  - m_Id: 247590371332096
    m_Localized: Block negates all damage from a hit
    m_Metadata:
      m_Items: []
  - m_Id: 247601490432000
    m_Localized: Block does not prevent {effect|Effects} from being applied
    m_Metadata:
      m_Items: []
  - m_Id: 247671870853120
    m_Localized: Chill is an {ailment|Ailment} caused by Cold hits
    m_Metadata:
      m_Items: []
  - m_Id: 247686471225344
    m_Localized: It reduces Attack Speed by 20%
    m_Metadata:
      m_Items: []
  - m_Id: 247699477762048
    m_Localized: Base Chill duration is 3 seconds
    m_Metadata:
      m_Items: []
  - m_Id: 247765575798784
    m_Localized: A shared defensive stat
    m_Metadata:
      m_Items: []
  - m_Id: 247782403346432
    m_Localized: It feeds {armor|Armor}, {evasion|Evasion}, {barrier|Barrier} power,
      and {block|Block} chance
    m_Metadata:
      m_Items: []
  - m_Id: 247885616779264
    m_Localized: Distract is an {effect|Effect} that can be applied to units
    m_Metadata:
      m_Items: []
  - m_Id: 247894802305024
    m_Localized: It reduces {accuracy|Accuracy} by 20%
    m_Metadata:
      m_Items: []
  - m_Id: 247903375462400
    m_Localized: Distract lasts 5 seconds
    m_Metadata:
      m_Items: []
  - m_Id: 247989987840000
    m_Localized: Effects can be applied to units
    m_Metadata:
      m_Items: []
  - m_Id: 248008887373824
    m_Localized: Effects include various negative effects, as well as {ailment|Ailments}
    m_Metadata:
      m_Items: []
  - m_Id: 248071780962304
    m_Localized: Covers fire, cold, and lightning
    m_Metadata:
      m_Items: []
  - m_Id: 248179712987136
    m_Localized: Gives attacks a chance to miss entirely
    m_Metadata:
      m_Items: []
  - m_Id: 248190060335104
    m_Localized: Its dodge chance is checked against attacker {accuracy|Accuracy}
    m_Metadata:
      m_Items: []
  - m_Id: 248299066101760
    m_Localized: Gems can be placed into {socketnode|Socket Nodes}
    m_Metadata:
      m_Items: []
  - m_Id: 248313007968256
    m_Localized: Gem grants its effect only while placed in a {socketnode|Socket
      Node}
    m_Metadata:
      m_Items: []
  - m_Id: 248348328202240
    m_Localized: Ignite is an {ailment|Ailment} caused by Fire hits
    m_Metadata:
      m_Items: []
  - m_Id: 248365214470144
    m_Localized: It stores 30% of dealt Fire damage in a single burning pool
    m_Metadata:
      m_Items: []
  - m_Id: 248374098006016
    m_Localized: Ignite damage is dealt over time at 40% of the remaining stored
      damage per second
    m_Metadata:
      m_Items: []
  - m_Id: 248452351135744
    m_Localized: Covers light and darkness damage
    m_Metadata:
      m_Items: []
  - m_Id: 248538325979136
    m_Localized: Overcharge is an {ailment|Ailment} caused by Lightning hits
    m_Metadata:
      m_Items: []
  - m_Id: 248576729026560
    m_Localized: It empowers the next hit against the target with 10% more damage
      and 20% more Crit Damage Bonus
    m_Metadata:
      m_Items: []
  - m_Id: 248584895336448
    m_Localized: Overcharge is consumed when this effect is used
    m_Metadata:
      m_Items: []
  - m_Id: 248713857601536
    m_Localized: Sunder is an {effect|Effect} that can be applied to units
    m_Metadata:
      m_Items: []
  - m_Id: 248718592970752
    m_Localized: It reduces {armor|Armor} by 20%
    m_Metadata:
      m_Items: []
  - m_Id: 248729670127616
    m_Localized: Sunder lasts 5 seconds
    m_Metadata:
      m_Items: []
  - m_Id: 292686433226752
    m_Localized: Resistance reduces incoming {elemental|Elemental} damage
    m_Metadata:
      m_Items: []
  - m_Id: 292724769165312
    m_Localized: '{elemental|Elemental} Resistance applies to all {elemental|Elemental}
      damage types'
    m_Metadata:
      m_Items: []
  - m_Id: 292734143434752
    m_Localized: Each {elemental|Elemental} damage type have also its own matching
      Resistance
    m_Metadata:
      m_Items: []
  - m_Id: 294350485590016
    m_Localized: Each Resistance has a default maximum value of 50%
    m_Metadata:
      m_Items: []
  - m_Id: 294655453433856
    m_Localized: '{elemental|Elemental} Resistance and matching Resistance stack'
    m_Metadata:
      m_Items: []
  - m_Id: 358944797233152
    m_Localized: Power increases how effective an {effect|Effect} is
    m_Metadata:
      m_Items: []
  - m_Id: 3211732585680896
    m_Localized: +2 Maximum Health per 1 Strength
    m_Metadata:
      m_Items: []
  - m_Id: 3213892748709888
    m_Localized: 1% increased Physical Damage per 2 Strength
    m_Metadata:
      m_Items: []
  - m_Id: 3214049204637696
    m_Localized: 1% increased Evasion per 1 Dexterity
    m_Metadata:
      m_Items: []
  - m_Id: 3214157480595456
    m_Localized: +0.1% Crit Chance per 10 Dexterity
    m_Metadata:
      m_Items: []
  - m_Id: 3214213218701312
    m_Localized: 1% increased Barrier Capacity per 2 Intelligence
    m_Metadata:
      m_Items: []
  - m_Id: 3214420366987264
    m_Localized: 1% increased Elemental Damage per 2 Intelligence
    m_Metadata:
      m_Items: []
  - m_Id: 3214420366987265
    m_Localized: While you have Profaned Health, take 50% more Damage
    m_Metadata:
      m_Items: []
  - m_Id: 5085118307897344
    m_Localized: Grants 30% increased {ailment|Ailment} Power and 20% increased {mystic|Mystic}
      Damage for 6 seconds.
    m_Metadata:
      m_Items: []
  - m_Id: 5086869182353408
    m_Localized: Each stack has its own duration.
    m_Metadata:
      m_Items: []
  - m_Id: 5342847077322752
    m_Localized: Grants 5% More Crit Chance and 20% less {evasion|Evasion} per stack
      for 6 seconds, up to 3 stacks.
    m_Metadata:
      m_Items: []
  - m_Id: 5346512051769344
    m_Localized: Each stack has its own duration.
    m_Metadata:
      m_Items: []
  - m_Id: 5346512051769345
    m_Localized: This node is inactive and grants no effects
    m_Metadata:
      m_Items: []
  - m_Id: 5346512051769346
    m_Localized: This node's Power cannot be changed
    m_Metadata:
      m_Items: []
  - m_Id: 5346512051769347
    m_Localized: Gain percentage of lost Health as Pain.
    m_Metadata:
      m_Items: []
  - m_Id: 6770548061376512
    m_Localized: Pain is consumed by your next attack to gain increased Damage equal
      to current Pain percentage of your Maximum Health.
    m_Metadata:
      m_Items: []
  - m_Id: 6773358702235648
    m_Localized: Damage over Time does not grant Pain.
    m_Metadata:
      m_Items: []
  - m_Id: 6773414712971264
    m_Localized: Pain gained while on Low Life is doubled.
    m_Metadata:
      m_Items: []
  - m_Id: 6805220107620352
    m_Localized: Scar grants increased {armor|Armor} and {ailmentGuard|Ailment Guard}
      equal to its percentage of your Maximum Health, but reduces Healing received
      by the same amount.
    m_Metadata:
      m_Items: []
  - m_Id: 6805365104709632
    m_Localized: Scar duration is 6 seconds
    m_Metadata:
      m_Items: []
  - m_Id: 6805365104709633
    m_Localized: Each stack grants 10% more Crit Damage Bonus and 10% less Crit Chance
    m_Metadata:
      m_Items: []
  - m_Id: 7253607030329344
    m_Localized: It reduces {ailmentGuard|Ailment Guard} by 30%
    m_Metadata:
      m_Items: []
  - m_Id: 7253576491601920
    m_Localized: Distract is an {effect|Effect} that can be applied to units
    m_Metadata:
      m_Items: []
  - m_Id: 7255200857460736
    m_Localized: Expose lasts 5 seconds
    m_Metadata:
      m_Items: []
  - m_Id: 7255200857460737
    m_Localized: Critical Regeneration
    m_Metadata:
      m_Items: []
  - m_Id: 7255200857460738
    m_Localized: Grants 3% of Maximum Health regeneration per second for 5 seconds.
    m_Metadata:
      m_Items: []
  references:
