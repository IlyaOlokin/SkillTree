    m_Metadata:
      m_Items: []
  - m_Id: 248584895336448
    m_Localized: Overcharge is consumed when this effect is used
    m_Metadata:
      m_Items: []
  - m_Id: 248713857601536
    m_Localized: Sunder is an {effect|Effect} that can be applied to units
    m_Metadata:
      m_Items: []
  - m_Id: 248718592970752
    m_Localized: It reduces {armor|Armor} by 20%
    m_Metadata:
      m_Items: []
  - m_Id: 248729670127616
    m_Localized: Sunder lasts 5 seconds
    m_Metadata:
      m_Items: []
